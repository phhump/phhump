<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the engine-independent simulation exactly like Unity does: .NET Standard 2.1, C# 9. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>StellarIndustries.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/StellarIndustries/Scripts/Core/**/*.cs" />
  </ItemGroup>
</Project>
