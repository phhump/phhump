<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile check of the Unity layer against UnityEngine 2021.3 LTS reference assemblies (no Unity install needed). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>StellarIndustries.Unity</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>UNITY_2021_3_OR_NEWER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/StellarIndustries/Scripts/Unity/**/*.cs" />
    <ProjectReference Include="../../HeadlessTests/Core/Core.csproj" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" PrivateAssets="all" />
  </ItemGroup>
</Project>
