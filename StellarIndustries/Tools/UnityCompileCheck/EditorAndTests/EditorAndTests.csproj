<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile check of editor scripts and the NUnit test wrapper. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>StellarIndustries.EditorAndTests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>UNITY_EDITOR;UNITY_INCLUDE_TESTS</DefineConstants>
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/StellarIndustries/Editor/**/*.cs" />
    <Compile Include="../../../Assets/StellarIndustries/Tests/**/*.cs" />
    <Compile Include="../../../Assets/StellarIndustries/Scripts/Unity/**/*.cs" />
    <ProjectReference Include="../../HeadlessTests/Core/Core.csproj" />
    
    <PackageReference Include="Unity3D.SDK" Version="2021.1.14.1" PrivateAssets="all" />
    <PackageReference Include="NUnit" Version="3.13.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
